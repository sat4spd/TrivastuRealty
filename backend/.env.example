# WhatsApp Cloud API
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=mangroo_verify_2026

# MongoDB
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/trivastuRealty

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-north-1
S3_BUCKET_PROPERTY_MEDIA=your-bucket-name
S3_BUCKET_CUSTOMER_DOCS=your-bucket-name
S3_BUCKET_AGENT_DOCS=your-bucket-name

# JWT
JWT_SECRET=generate_a_strong_64_char_random_string

# LLM
OPENAI_API_KEY=sk-proj-your_openai_key
GEMINI_API_KEY=your_gemini_key

# Admin WhatsApp Numbers (comma-separated)
ADMIN_WHATSAPP_NUMBER=+91XXXXXXXXXX
ADMIN_WHATSAPP_NUMBERS=+91XXXXXXXXXX,+91XXXXXXXXXX,+91XXXXXXXXXX

# Email (AWS SES or SMTP)
EMAIL_HOST=email-smtp.eu-north-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USER=your_ses_smtp_user
EMAIL_PASS=your_ses_smtp_password
EMAIL_FROM=contact@yourdomain.com

# Server
PORT=3000
NODE_ENV=production
